APP_NAME=YOLO11 API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

YOLO_MODEL_PATH=data/models/yolo11n.pt
# SHA-256 do arquivo do modelo; a API recusa carregar se não bater.
# Calcule com: sha256sum data/models/yolo11n.pt
YOLO_MODEL_SHA256=0ebbc80d4a7680d14987a577cd21342b65ecfd94632bd9a8da63ae6417644ee1
LOAD_MODEL_ON_STARTUP=true
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_PIXELS=40000000

UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
MIN_FREE_DISK_MB=500

# Fora de development/test, a API não sobe com chave fraca (mín. 32 caracteres).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me
# Chaves adicionais aceitas (rotação), em JSON: ["chave-nova"]
EXTRA_API_KEYS=[]

ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]