APP_NAME=YOLO11 API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
# text (legível) ou json (para Loki/ELK/Graylog)
LOG_FORMAT=text
# GET /metrics (Prometheus), protegido pela API key
METRICS_ENABLED=true
API_PREFIX=/api/v1

YOLO_MODEL_PATH=data/models/yolo11n.pt
# SHA-256 do arquivo do modelo; a API recusa carregar se não bater.
# Calcule com: sha256sum data/models/yolo11n.pt
YOLO_MODEL_SHA256=0ebbc80d4a7680d14987a577cd21342b65ecfd94632bd9a8da63ae6417644ee1
LOAD_MODEL_ON_STARTUP=true

# Parâmetros de inferência (registrados em cada resultado)
YOLO_CONF=0.25
YOLO_IOU=0.7
YOLO_IMGSZ=640
YOLO_MAX_DET=300
# Vazio = automático; exemplos: cpu, 0 (primeira GPU)
YOLO_DEVICE=
YOLO_HALF=false
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_PIXELS=40000000

UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
MIN_FREE_DISK_MB=500
SAVE_UPLOADS=true
SAVE_ANNOTATED=true
# png ou jpg (jpg ocupa bem menos disco)
ANNOTATED_IMAGE_FORMAT=png
# Apaga uploads e resultados mais antigos que N dias (0 = desligado)
RETENTION_DAYS=0
RETENTION_INTERVAL_MINUTES=60

# Demo web (/demo): fotografar, marcar, treinar e testar pelo celular
DEMO_ENABLED=true
DEMO_DIR=data/demo
# A primeira classe é a peça; as outras marcam defeitos (ex.: onde falta algo)
DEMO_CLASSES=["peca","falta"]
DEMO_TRAIN_EPOCHS=30
DEMO_TRAIN_IMGSZ=512
DEMO_TRAIN_BATCH=8
DEMO_MIN_IMAGES=4
# Uma peça por foto: fica só a peça mais provável e as faltas dentro dela
DEMO_SINGLE_PART=true

# Fora de development/test, a API não sobe com chave fraca (mín. 32 caracteres).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me
# Chaves adicionais aceitas (rotação), em JSON: ["chave-nova"]
EXTRA_API_KEYS=[]

ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]